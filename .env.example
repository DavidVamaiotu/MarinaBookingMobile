# Public Marina OAuth configuration. Access tokens remain in memory and the
# refresh token is encrypted with the platform secure-storage service.
MARINA_INTEGRATION_ENABLED=false
MARINA_API_BASE_URL=https://booking.husi.ro
MARINA_OAUTH_CLIENT_ID=
MARINA_OAUTH_SCOPES=resources:read resources:write bookings:read bookings:write

# Optional explicit workspace IDs. Leave blank to resolve active workspaces
# from GET /v1/workspaces using the rooms and camping slugs.
MARINA_ROOMS_WORKSPACE_ID=
MARINA_CAMPING_WORKSPACE_ID=
